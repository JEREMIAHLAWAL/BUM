# BUM (Generalized Multi-Agent SWE Orchestrator) Environment Configuration

# ----------------------------------------------------------------------
# 1. LLM Provider API Keys (Configure at least one)
# ----------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Local / Self-Hosted Inference
OLLAMA_BASE_URL=http://localhost:11434

# ----------------------------------------------------------------------
# 2. Orchestrator & Execution Settings
# ----------------------------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=120.0
MAX_REVIEW_CYCLES=3

# ----------------------------------------------------------------------
# 3. Server & Networking
# ----------------------------------------------------------------------
AGENT_FLOW_HOST=0.0.0.0
AGENT_FLOW_PORT=8900

# ----------------------------------------------------------------------
# 4. Target Repository Path (Optional)
# If unset, BUM dynamically detects sibling workspaces or uses the UI selector.
# ----------------------------------------------------------------------
# TARGET_REPO_PATH=/path/to/your/project
