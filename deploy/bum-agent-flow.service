[Unit]
Description=BUM Multi-Agent SWE Orchestrator Control Room
After=network.target

[Service]
Type=simple
User=jelawal
WorkingDirectory=/home/jelawal/AGENT/JL/BUM
Environment=PYTHONUNBUFFERED=1
Environment=AGENT_FLOW_HOST=0.0.0.0
Environment=AGENT_FLOW_PORT=8900
Environment="PATH=/home/jelawal/.local/bin:/usr/local/bin:/usr/bin:/bin"
EnvironmentFile=/home/jelawal/AGENT/JL/BUM/.env
ExecStart=/home/jelawal/AGENT/JL/BUM/.venv/bin/python run_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
